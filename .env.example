# AWS / S3
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=vo-seoul-s3
# Local scripts only. Leave unset on EC2, where the instance role grants S3 access.
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Database
DATABASE_URL=postgresql+psycopg://vo_admin:vo_password@localhost:5432/vo_db
ASYNC_DATABASE_URL=postgresql+asyncpg://vo_admin:vo_password@localhost:5432/vo_db

# Optimizer
NEUFERT_RULES_JSONL=workers/optimizer/data/neufert_rules_approved.jsonl

# Auth (deploy.yml overwrites these on EC2 from GitHub secrets)
JWT_SECRET_KEY=your-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# RAG extraction scripts (workers/rag) only
OPENAI_API_KEY=
OPENAI_VISION_MODEL=

# AI layout constraints and assistant
AI_LAYOUT_ENABLED=false
AI_LAYOUT_TIMEOUT_SECONDS=60
ANTHROPIC_API_KEY=
AI_LAYOUT_PROVIDER=anthropic
ASSISTANT_MODEL=claude-sonnet-5
AI_LAYOUT_MAX_TOKENS=4096

# Email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-gmail-address
SMTP_FROM_NAME=V-O
EMAIL_VERIFICATION_DEBUG=false

# Guestbook card email (shared with the website server)
GUESTBOOK_API_KEY=
