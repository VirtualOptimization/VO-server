AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
DATABASE_URL=postgresql+psycopg://vo_user:vo_password@localhost:5432/vo_db
MODEL_CATALOG_ROOT=/path/to/RoomPlanCatalog.bundle/Resources
MODEL_CATALOG_S3_PREFIX=https://your-s3-bucket/models
MODEL_CATALOG_S3_BUCKET=your-bucket-name
MODEL_CATALOG_S3_KEY_PREFIX=models
VO_RDS_STACK_NAME=vo-rds-stack
VO_RDS_INSTANCE_IDENTIFIER=vo-rds-dev
VO_RDS_DB_NAME=vo_db
VO_RDS_DB_USERNAME=vo_admin
VO_RDS_PUBLICLY_ACCESSIBLE=true
VO_RDS_ALLOWED_IPV4=0.0.0.0/0
VO_RDS_ALLOCATED_STORAGE_GB=20
VO_RDS_MAX_ALLOCATED_STORAGE_GB=20
